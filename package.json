  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:server": "node server/index.mjs",
    "dev:server:test": "node server/bootstrap.mjs test.env",
    "dev:trigger": "trigger dev",
    "dev:trigger:test": "trigger dev --env-file test.env",
    "dev:full": "concurrently \"npm run dev\" \"npm run dev:server\"",
    "dev:full:trigger": "concurrently \"npm run dev\" \"npm run dev:server\" \"npm run dev:trigger\"",
    "dev:field:test": "concurrently \"npm run dev\" \"npm run dev:server:test\" \"npm run dev:trigger:test\"",
    "dev:field:test:start": "powershell -ExecutionPolicy Bypass -File scripts/start-field-test.ps1",
    "build": "vite build",
    "test:calendar": "node --test src/trigger/calendarRules.test.ts src/trigger/calendarManageRules.test.ts",
    "test:field": "node --test server/fieldLeadCore.test.mjs server/fieldLeadCrmSync.test.mjs server/fieldLeadEnv.test.mjs server/fieldLeadStore.test.mjs server/fieldLeadNotifications.test.mjs server/fieldLeadService.test.mjs server/fieldLeadRoutes.test.mjs src/trigger/fieldLeadTasks.test.ts",
    "test:smoke:field": "node server/scripts/fieldLeadSmoke.mjs",
    "test:smoke:manage": "node server/scripts/manageBookingSmoke.mjs",
    "sync:field-crm": "node server/scripts/syncFieldLeadSheetsCrm.mjs",
    "reset:field-demo-crm": "node server/scripts/resetFieldLeadDemoCrm.mjs",
    "sync:vercel:field-preview-env": "node server/scripts/syncVercelFieldPreviewEnv.mjs",
    "sync:vercel:field-prod-env": "node server/scripts/syncVercelFieldProductionEnv.mjs",
    "sync:vercel:field-prod-activate": "node server/scripts/activateVercelFieldProductionEnv.mjs",
    "backfill:manage-links": "node server/scripts/backfillManageLinks.mjs",
    "deploy:trigger": "trigger deploy",
    "deploy:trigger:prod": "npx trigger.dev@latest deploy --env prod --env-file prod.env",
    "preview": "vite preview"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@tailwindcss/vite": "^4.1.18",
    "@trigger.dev/sdk": "4.4.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-rate-limit": "^8.2.1",
    "framer-motion": "^12.31.0",
    "googleapis": "^171.4.0",
    "gsap": "^3.14.2",
    "lucide-react": "^0.563.0",
    "luxon": "^3.7.2",
    "motion": "^12.31.0",
    "multer": "^2.0.2",
    "nodemailer": "^7.0.9",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
